pipeline {

    agent any

    tools {
        maven 'Maven-3.8'
        jdk 'JDK-21'
    }

    environment {
        APP_NAME = "maheflix"
        SERVER_IP = "54.200.67.45"
        REPO_DIR = "maheflix-jenkins"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Deploy') {
    steps {
        sh """
        ssh -o StrictHostKeyChecking=no ubuntu@${SERVER_IP} '
            set -e

            export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
            export PATH=\\$JAVA_HOME/bin:\\$PATH

            echo "===== JAVA ====="
            java -version

            echo "===== JAVAC ====="
            javac -version

            echo "===== MAVEN ====="
            mvn -version

            rm -rf ${REPO_DIR}

            git clone https://github.com/nallam-mahendra/${REPO_DIR}.git

            cd ${REPO_DIR}/${APP_NAME}

            echo "===== BUILDING ====="
            mvn clean package

            echo "===== DEPLOYING ====="
            sudo cp target/${APP_NAME}.war /opt/tomcat/webapps/

            echo "===== DEPLOYMENT SUCCESSFUL ====="
        '
        """
    }
}
                '
                """
            }
        }
    }
}
