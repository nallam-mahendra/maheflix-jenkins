pipeline {

    agent any

    tools {
        maven 'Maven-3.8'
        jdk 'JDK-21'
    }

    environment {
        APP_NAME = "maheflix"
        SERVER_IP = "35.87.12.190"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "===== CHECKOUT SOURCE CODE ====="
                checkout scm
            }
        }

        stage('Check Java and Maven') {
            steps {
                sh '''
                    export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
                    export PATH=$JAVA_HOME/bin:$PATH

                    echo "===== JAVA HOME ====="
                    echo "JAVA_HOME=$JAVA_HOME"

                    echo "===== JAVA VERSION ====="
                    java -version

                    echo "===== JAVAC VERSION ====="
                    javac -version

                    echo "===== MAVEN VERSION ====="
                    mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                dir('maheflix') {
                    sh '''
                        export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
                        export PATH=$JAVA_HOME/bin:$PATH

                        echo "===== BUILDING MAHEFLIX ====="

                        mvn clean package

                        echo "===== BUILD SUCCESS ====="

                        ls -lh target/

                        echo "===== WAR FILE ====="

                        ls -lh target/maheflix-webapp.war
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "===== DEPLOY STAGE ====="

                /*
                 * Deployment will be added after
                 * Maven build is confirmed successful.
                 */
            }
        }
    }

    post {
        success {
            echo "===== PIPELINE SUCCESS ====="
        }

        failure {
            echo "===== PIPELINE FAILED ====="
        }
    }
}
